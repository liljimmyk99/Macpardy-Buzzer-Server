# Copy to .env and fill in. Used by docker-compose.yml.

# The domain phones and the Mac use, e.g. macpardy-quiz.duckdns.org
MACPARDY_DOMAIN=

# Optional (defaults shown)
# MACPARDY_GRACE_PERIOD=45
# MACPARDY_MAX_ROOMS=20
# MACPARDY_MAX_PHONES_PER_ROOM=24
# MACPARDY_LOG_LEVEL=info

# Only for `docker compose --profile duckdns up -d`
# DUCKDNS_SUBDOMAIN=macpardy-quiz
# DUCKDNS_TOKEN=
